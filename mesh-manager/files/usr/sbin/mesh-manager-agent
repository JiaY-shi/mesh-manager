#!/usr/bin/ucode
// SPDX-License-Identifier: GPL-2.0-only
'use strict';
import * as uloop from 'uloop';
import { collection_start } from 'mesh_manager.collection';
import { agent_runner } from 'mesh_manager.agent_schedule';
import { note } from 'mesh_manager.event_log';
import { boot, now, load } from 'mesh_manager.durable';
import { publish_observation } from 'mesh_manager.runtime';

uloop.init();
const stop_collection = collection_start();
let timer;
const work = agent_runner(() => load('identity.json'), kind =>
	require(kind == 'ap' ? 'mesh_manager.ap_agent_worker' : 'mesh_manager.controller_agent_worker'));

function tick() {
	let result = { ok: true };
	try {
		if (work() === false) exit(1);
	} catch (e) {
		result = {
			ok: false,
			error: match(e.message || '', /^([a-z_]{1,32}): /)?.[1] || 'internal_error'
		};
	}
	try {
		publish_observation('/var/run/mesh-manager-agent.json', {
			...result, timestamp: time(), boot: boot(), uptime: now()
		});
	} catch(e) {
		// A failed temporary status publication must not stop the next agent tick.
		note('agent','storage_error',null);
	}
	if(result.error!='busy')note('agent',result.ok ? 'ok' : result.error,null);
	timer.set(3000);
}

timer = uloop.timer(1000, tick);
uloop.run();
stop_collection();
