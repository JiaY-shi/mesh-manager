#!/usr/bin/ucode
// SPDX-License-Identifier: GPL-2.0-only
'use strict';
import * as fs from 'fs';
import { regulatory_query, regulatory_binding, regulatory_phy_binding, regulatory_request } from 'mesh_manager.regulatory_worker';

function monotonic() {
	let uptime=fs.readfile('/proc/uptime'),first=type(uptime)=='string'?split(uptime,' ')[0]:null;
	if(type(first)!='string' || !match(first,/^[0-9]+\.[0-9]+$/))die('read_failed: Monotonic query clock is unavailable');
	let value=int(+first*1000);
	if(type(value)!='int' || value<0 || value>9007199254738991)die('read_failed: Monotonic query clock is unavailable');
	return value;
}
let result;
try {
	let started_at=monotonic(),input=fs.stdin.read(8193) || '';
	if(length(ARGV) || !length(input) || length(input)>8192)die('invalid_request: Invalid private regulatory request');
	let target=regulatory_request(json(input)),nl;
	try { nl=require('nl80211'); }catch(e) { die('backend_unavailable: Official regulatory module is unavailable'); }
	if(type(nl?.request)!='function' || type(nl?.const)!='object')die('backend_unavailable: Official regulatory module is unavailable');
	result=regulatory_query(target,{started_at,now:monotonic,binding:ifname=>regulatory_binding(ifname,{read:fs.readfile,stat:fs.stat,readlink:fs.readlink}),
		phy_binding:phy=>regulatory_phy_binding(phy,{read:fs.readfile,stat:fs.stat}),
		get:(operation,attrs)=>{
			let command={GET_REG:nl.const.NL80211_CMD_GET_REG,GET_WIPHY:nl.const.NL80211_CMD_GET_WIPHY,GET_INTERFACE:nl.const.NL80211_CMD_GET_INTERFACE}[operation];
			if(type(command)!='int')die('backend_unavailable: Official GET operation is unavailable');
			return nl.request(command,0,attrs);
		}});
	print(sprintf('%J',result));
}catch(e) {
	let code=match(''+e,/([a-z_]+):/)?.[1];
	if(index(['invalid_request','backend_unavailable','read_failed','result_too_large','target_changed','budget_exceeded'],code)<0)code='read_failed';
	print(sprintf('%J',{schema:1,status:'unavailable',reason:code}));exit(1);
}
