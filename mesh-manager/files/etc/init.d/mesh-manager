#!/bin/sh /etc/rc.common

START=18
STOP=89
USE_PROCD=1

start_service() {
	local instances
	instances=$(/usr/bin/ucode -e 'import { service_desired } from "mesh_manager.service_runtime"; print(join(" ",service_desired().instances));') || return 1
	# Each long-lived VM collects cycles between event-loop callbacks.
	case " $instances " in *" instance1 "*)
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/mesh-manager
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	esac
	case " $instances " in *" enrollment "*)
	procd_open_instance enrollment
	procd_set_param command /usr/bin/ucode /usr/sbin/mesh-manager-enrollment
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	esac
	case " $instances " in *" backhaul "*)
	procd_open_instance backhaul
	procd_set_param command /usr/bin/ucode /usr/sbin/mesh-manager-backhaul
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	esac
	case " $instances " in *" agent "*)
	procd_open_instance agent
	procd_set_param command /usr/bin/ucode /usr/sbin/mesh-manager-agent
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	esac
	local address
	rm -f /var/run/mesh-manager-listening
	case " $instances " in *" node "*) ;; *) return 0 ;; esac
	address=$(/usr/bin/ucode -l fs -e 'let d,s; try { d=json(fs.readfile("/etc/mesh-manager/identity.json") || "null"); s=json(fs.readfile("/etc/mesh-manager/state.json") || "null"); } catch(e) {} if(d?.role == "root" && (s?.paused !== true || s.active?.mesh_enabled === true && index(["committed","rolled_back","rollback_conflict","expired"],s.active.status)<0)) print(d.address);')
	[ -n "$address" ] || return 0
	touch /var/run/mesh-manager-listening
	for mode in node enroll control; do
		local port=37901
		local bind_address="$address" channel_mode="$mode"
		[ "$mode" = enroll ] && port=37902
		if [ "$mode" = control ]; then
			bind_address=169.254.254.1
			channel_mode=node
		fi
		procd_open_instance "$mode"
		procd_set_param command /usr/libexec/mesh-manager-channel serve "$bind_address" "$port" /etc/mesh-manager/network-ca.crt /etc/mesh-manager/device.crt /etc/mesh-manager/device.key "$channel_mode"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		if [ "$mode" = enroll ]; then
			local id network name fingerprint
			id=$(jsonfilter -i /etc/mesh-manager/identity.json -e '@.id')
			network=$(jsonfilter -i /etc/mesh-manager/identity.json -e '@.network_id')
			name=$(jsonfilter -i /etc/mesh-manager/identity.json -e '@.name')
			fingerprint=$(/usr/bin/ucode -l fs -e 'import * as crypto from "mesh_crypto"; print(crypto.fingerprint(fs.readfile("/etc/mesh-manager/network-ca.crt") || ""))')
			if [ "${#id}" -eq 32 ] && [ "${#network}" -eq 32 ] && [ "${#fingerprint}" -eq 64 ]; then
				procd_add_mdns mesh-manager tcp "$port" "role=root" "id=$id" "network=$network" "ca=$fingerprint" "name=$name"
			fi
		fi
		procd_close_instance
	done
}

# procd preserves unchanged instances. A role transition must not kill a live
# enrollment actor merely to start its configuration agent.
reload_service() { start; }

# Give the independently owned temporary STA its bounded, verified cleanup
# before procd terminates descendants of the agent's process group.
stop_service() {
	/usr/bin/ucode -e 'import { onboard_standby_stop } from "mesh_manager.onboarding"; onboard_standby_stop();' >/dev/null 2>&1
}

# Configuration is changed only through the transactional RPC, not reload triggers.
